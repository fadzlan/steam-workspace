{
  "name": "steam-workspace",
  "version": "0.1.0",
  "description": "Steam wishlist workspace: tag bubbles, price/discount charts and a buying-decision list.",
  "main": "src/main/main.js",
  "author": "fadzlan",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "test": "node --test \"test/*.test.js\"",
    "dist:linux": "electron-builder --linux",
    "dist:win": "electron-builder --win",
    "dist": "electron-builder --linux --win"
  },
  "build": {
    "appId": "com.fadzlan.steamworkspace",
    "productName": "Steam Workspace",
    "files": [
      "src/**/*",
      "resources/**/*",
      "package.json"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Utility"
    },
    "win": {
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "directories": {
      "output": "dist"
    }
  },
  "dependencies": {
    "@fontsource/barlow-semi-condensed": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "d3": "^7.9.0"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3"
  }
}
